    "/api/v1/simulate": {
      "post": {
        "description": "Baseline vs patch, same rules and data version.\n\nFrontend contract: {\"baseline_profile\": <flat>, \"patch\": <flat partial>,\n\"program_ids\": [...]} -> {\"baseline\": <MatchResponse>,\n\"scenario\": <MatchResponse>, \"delta\": [{program_id, rule_id,\nbaseline_status, scenario_status}]}.\nSpec/test contract: {\"profile\": <nested>, \"program_id\": str,\n\"patch\": <nested dict>} -> {\"program_id\", \"baseline\", \"patched\"}.\nPatch is a deep-merge onto the profile dict. Changing language overall\nmust NOT change the component scores (they are separate fields).",
        "operationId": "simulate_api_v1_simulate_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
