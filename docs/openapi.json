  "info": {
    "title": "PathPilot AI \u2014 Day 2 backend",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/explain": {
      "post": {
        "description": "Server-side recompute (spec Ch12). New shape:\n{\"profile\": <nested StudentProfile | flat wizard profile>,\n \"program_ids\": [...], \"locale\": \"en\"}.\nA client-supplied Evaluation (the Day-1 shape {\"evaluation\": ...}) is\nrejected with 422 EXPLAIN_REQUIRES_PROFILE \u2014 the server recomputes, it\nnever repeats a caller's verdict. Returns one recomputed explanation\nper program, in the same multi-program shape as /match.",
        "operationId": "explain_api_v1_explain_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Explain"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/institutions/{institution_id}/rankings": {
      "get": {
        "description": "One institution's provider records \u2014 or each one's explicit\nmissing reason. World ranks only; no cross-provider combination.",
        "operationId": "get_institution_rankings_api_v1_institutions__institution_id__rankings_get",
        "parameters": [
          {
            "in": "path",
            "name": "institution_id",
            "required": true,
            "schema": {
              "title": "Institution Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Institution Rankings"
      }
    },
    "/api/v1/match": {
      "post": {
        "description": "Two shapes, one engine.\n\nFrontend contract: {\"profile\": <flat wizard profile>, \"program_ids\": [...]}\n-> {\"evaluation_id\", \"results\": [{programId, eligibilitySummary,\nruleResults}], \"rules_version\", \"source_manifest_hash\"}.\nSpec/test contract: {\"profile\": <nested StudentProfile>, \"program_id\": str}\n-> single Evaluation (unchanged).",
        "operationId": "match_api_v1_match_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Match"
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "description": "The generated OpenAPI spec under the /api/v1 prefix (the default\nFastAPI /openapi.json stays enabled too). docs/openapi.json is a copy\nof this, produced by tools/generate_openapi.py.",
        "operationId": "openapi_v1_api_v1_openapi_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Openapi V1"
      }
    },
