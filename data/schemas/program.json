{"$id":"https://pathpilot.ai/schemas/program.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"application_deadline":{"description":"Null means UNKNOWN — not stated in a verified source. Never invent a date.","type":["string","null"]},"city":{"type":"string"},"country":{"enum":["GB","SG"],"type":"string"},"degree_level":{"enum":["undergraduate","taught_masters"],"type":"string"},"duration":{"type":"string"},"fees":{"properties":{"application_fee_sgd":{"type":["number","null"]},"currency":{"type":"string"},"notes":{"type":"string"},"overseas_per_year_gbp":{"type":["number","null"]},"period":{"enum":["per_year","total"],"type":"string"},"total_sgd_incl_gst":{"type":["number","null"]},"uk_per_year_gbp":{"type":["number","null"]}},"type":"object"},"id":{"pattern":"^[a-z0-9-]+$","type":"string"},"institution":{"minLength":1,"type":"string"},"intake":{"type":"string"},"intake_year":{"type":"integer"},"name_localized":{"description":"Presentation-layer display names per locale (degree part only). Never overwrites official_name. Locales without an entry fall back to official_name.","properties":{"ar":{"type":"string"},"es":{"type":"string"},"fr":{"type":"string"},"pt-BR":{"type":"string"},"zh-CN":{"type":"string"}},"type":"object"},"official_name":{"minLength":1,"type":"string"},"requirements":{"items":{"$ref":"requirement.json"},"type":"array"},"school":{"type":"string"},"sources":{"items":{"$ref":"source.json"},"minItems":1,"type":"array"},"start":{"type":"string"},"study_mode":{"enum":["full-time","part-time"],"type":"string"},"subject":{"type":"string"},"synthetic":{"default":false,"description":"True only for test fixtures. Real programs.json must never contain synthetic=true.","type":"boolean"},"ucas_code":{"type":"string"}},"required":["id","institution","country","degree_level","official_name","subject","sources"],"title":"Program","type":"object"}